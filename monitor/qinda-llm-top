def human_bytes(n: float) -> str:
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if abs(n) < 1024 or unit == "TiB":
            return f"{n:.1f} {unit}" if unit not in ("B", "KiB") else f"{n:.0f} {unit}"
        n /= 1024
    return f"{n:.1f}"


def human_rate(n: float) -> str:
    return human_bytes(n) + "/s"


def human_time(seconds: float) -> str:
    seconds = int(seconds)
    d, rem = divmod(seconds, 86400)
    h, rem = divmod(rem, 3600)
    m, s = divmod(rem, 60)
    if d:
        return f"{d}d {h}h"
    if h:
        return f"{h}h {m:02d}m"
    return f"{m}m {s:02d}s"


def sparkline(values, width: int, top: float | None = None) -> str:
    vals = list(values)[-width:]
    if not vals:
        return ""
    peak = top or max(max(vals), 1e-9)
    out = []
    for v in vals:
        idx = 0 if v <= 0 else min(len(SPARK) - 1, 1 + int((v / peak) * (len(SPARK) - 2)))
        out.append(SPARK[idx])
    return "".join(out).rjust(width)


