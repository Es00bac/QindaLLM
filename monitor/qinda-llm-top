SERVICE = "qinda-llm.service"
HISTORY = 240                       # samples kept for the sparklines (1 per second)
SPARK = " ▁▂▃▄▅▆▇█"

# ------------------------------------------------------------------ config --


def read_env(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    try:
        text = path.read_text()
    except OSError:
        return values
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        try:
            values[key.strip()] = " ".join(shlex.split(value, comments=True))
        except ValueError:
            values[key.strip()] = value.strip()
    return values


def read_presets(path: Path) -> dict[str, dict[str, str]]:
    parser = configparser.ConfigParser(interpolation=None, strict=False,
                                       inline_comment_prefixes=(";", "#"))
    try:
        text = path.read_text()
    except OSError:
        return {}
    # Keys before the first section (version = 1) are not INI; give them one.
    parser.read_string("[__top__]\n" + text)
    shared = dict(parser["*"]) if parser.has_section("*") else {}
    presets = {}
    for name in parser.sections():
        if name in ("__top__", "*"):
            continue
        merged = dict(shared)
        merged.update(parser[name])
        presets[name] = merged
    return presets


def read_api_key() -> str:
    candidates = []
    if os.environ.get("CREDENTIALS_DIRECTORY"):
        candidates.append(Path(os.environ["CREDENTIALS_DIRECTORY"]) / "api-key")
    candidates += [ETC / "api-key", Path.home() / ".config/qinda-llm/api-key"]
    if os.environ.get("QINDA_LLM_API_KEY"):
        return os.environ["QINDA_LLM_API_KEY"].strip()
    for path in candidates:
        try:
            return path.read_text().strip().splitlines()[0]
        except (OSError, IndexError):
            continue
    return ""


# -------------------------------------------------------------------- http --


class Api:
    def __init__(self, base: str, key: str) -> None:
        self.base = base.rstrip("/")
        self.key = key
        self.error = ""

    def _request(self, path: str, body: dict | None = None, timeout: float = 2.0) -> bytes | None:
        req = urllib.request.Request(self.base + path)
        if self.key:
            req.add_header("Authorization", f"Bearer {self.key}")
        if body is not None:
            req.data = json.dumps(body).encode()
            req.add_header("Content-Type", "application/json")
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                self.error = ""
                return resp.read()
        except urllib.error.HTTPError as exc:
            self.error = f"HTTP {exc.code} on {path}"
        except (urllib.error.URLError, OSError, socket.timeout) as exc:
            reason = getattr(exc, "reason", exc)
            self.error = f"{reason}"
        return None

    def json(self, path: str, body: dict | None = None, timeout: float = 2.0):
        raw = self._request(path, body, timeout)
        if raw is None:
            return None
        try:
            return json.loads(raw)
        except ValueError:
            return None

    def text(self, path: str) -> str | None:
        raw = self._request(path)
        return raw.decode(errors="replace") if raw is not None else None


def parse_metrics(text: str) -> dict[str, float]:
    """Prometheus text exposition -> {name without llamacpp: prefix: value}."""
    out: dict[str, float] = {}
    for line in text.splitlines():
        if not line or line.startswith("#"):
            continue
        parts = line.split()
        if len(parts) < 2:
            continue
        name = parts[0].split("{", 1)[0]
        name = name.split(":", 1)[1] if ":" in name else name
        try:
            out[name] = float(parts[1])
        except ValueError:
            continue
    return out


def model_status(entry: dict) -> str:
    status = entry.get("status")
    if isinstance(status, dict):
        return str(status.get("value", "unknown"))
    return str(status or "unknown")


# ----------------------------------------------------------------- journal --

TIMING_PP = re.compile(r"prompt eval time =\s*([\d.]+) ms /\s*(\d+) tokens .*?([\d.]+) tokens per second")
TIMING_TG = re.compile(r"^(?:.*?\s)?eval time =\s*([\d.]+) ms /\s*(\d+) tokens .*?([\d.]+) tokens per second")
# The router forwards each model instance's output as "[<port>] <line>" and
# announces "spawning server instance with name=<model> on port <port>".
CHILD_TAG = re.compile(r"^\[\s*(\d+)\]\s")
SPAWN = re.compile(r"spawning server instance with name=(\S+) on port (\d+)")
LOAD_FACTS = [
    ("layers", re.compile(r"offloaded (\d+)/(\d+) layers to GPU")),
    ("gpu_buf", re.compile(r"(?:Vulkan0|ROCm0|CUDA0) model buffer size =\s*([\d.]+) MiB")),
    ("cpu_buf", re.compile(r"CPU(?:_Mapped|_REPACK)? model buffer size =\s*([\d.]+) MiB")),
    ("kv", re.compile(r"llama_kv_cache: .*size =\s*([\d.]+) MiB")),
    ("n_cpu_moe", re.compile(r"n_cpu_moe\s*[=:]\s*(\d+)")),
    ("fa", re.compile(r"flash_attn\s*=\s*(\w+)")),
    ("graph_splits", re.compile(r"graph splits = (\d+)")),
]


@dataclass
class Request:
    when: str
    model: str
    prompt_tokens: int
    prompt_ms: float
    prompt_tps: float
    gen_tokens: int = 0
    gen_ms: float = 0.0
    gen_tps: float = 0.0


def parse_journal(lines: list[str]) -> tuple[list[Request], dict[str, str], list[str]]:
    """Completed requests, model load facts and the log tail from journal lines."""
    requests: list[Request] = []
    facts: dict[str, str] = {}
    pending: Request | None = None
    ports: dict[str, str] = {}
    for line in lines:
        when = line[11:19] if len(line) > 19 and line[4] == "-" else ""
        message = line.split("]: ", 1)[1] if "]: " in line else line
        spawn = SPAWN.search(message)
        if spawn:
            ports[spawn.group(2)] = spawn.group(1)
            facts = {}                     # a new instance: forget the old one's facts
            continue
        tag = CHILD_TAG.match(message)
        model = ports.get(tag.group(1), "") if tag else ""
        m = TIMING_PP.search(line)
        if m:
            pending = Request(when, model, int(m.group(2)), float(m.group(1)), float(m.group(3)))
            continue
        m = TIMING_TG.search(line)
        if m and "prompt eval" not in line and pending is not None:
            pending.gen_ms, pending.gen_tokens, pending.gen_tps = (
                float(m.group(1)), int(m.group(2)), float(m.group(3)))
            requests.append(pending)
            pending = None
            continue
        if "load_tensors" in line or "llama_" in line or "fit" in line:
            for key, rx in LOAD_FACTS:
                fm = rx.search(line)
                if fm:
                    facts[key] = "/".join(fm.groups())
    return requests, facts, lines[-400:]


def journal(unit: str, lines: int = 1500) -> list[str]:
    try:
        out = subprocess.run(
            ["journalctl", "-u", unit, "-b", "-o", "short-iso", "--no-pager", "-n", str(lines)],
            capture_output=True, text=True, timeout=4)
        return out.stdout.splitlines()
    except (OSError, subprocess.TimeoutExpired):
        return []


# ------------------------------------------------------------------ system --


def read(path: str | Path, default: str = "") -> str:
    try:
        return Path(path).read_text().strip()
    except OSError:
        return default


def hwmon(name: str) -> Path | None:
    for d in Path("/sys/class/hwmon").glob("hwmon*"):
        if read(d / "name") == name:
            return d
    return None


class System:
    def __init__(self) -> None:
        self.prev_cpu: list[list[int]] | None = None
        self.prev_net: tuple[float, int, int] | None = None
        self.cpu_pct = 0.0
        self.core_pct: list[float] = []
        self.net_rx = self.net_tx = 0.0
        self.gpu_dev = self._find_gpu()
        self.k10 = hwmon("k10temp")
        self.gpu_hwmon = next(iter((self.gpu_dev / "hwmon").glob("hwmon*")), None) if self.gpu_dev else None
        self.net_if = "tailscale0" if Path("/sys/class/net/tailscale0").exists() else ""

    @staticmethod
    def _find_gpu() -> Path | None:
        for card in sorted(Path("/sys/class/drm").glob("card[0-9]")):
            dev = card / "device"
            if (dev / "mem_info_vram_total").exists():
                return dev
        return None

    def sample(self) -> dict:
        s: dict = {}
        stat = [l.split() for l in read("/proc/stat").splitlines() if l.startswith("cpu")]
        cpus = [[int(v) for v in row[1:9]] for row in stat]
        if self.prev_cpu and len(self.prev_cpu) == len(cpus):
            pct = []
            for old, new in zip(self.prev_cpu, cpus):
                idle = (new[3] + new[4]) - (old[3] + old[4])
                total = sum(new) - sum(old)
                pct.append(100.0 * (1 - idle / total) if total > 0 else 0.0)
            self.cpu_pct, self.core_pct = pct[0], pct[1:]
        self.prev_cpu = cpus
        s["cpu"] = self.cpu_pct
        s["cores"] = self.core_pct
        s["load"] = read("/proc/loadavg").split()[:3]
        freqs = [int(read(p, "0")) for p in Path("/sys/devices/system/cpu").glob("cpu[0-9]*/cpufreq/scaling_cur_freq")]
        s["mhz"] = (sum(freqs) / len(freqs) / 1000) if freqs else 0
        s["cpu_temp"] = int(read(self.k10 / "temp1_input", "0")) / 1000 if self.k10 else 0

        mem = {}
        for line in read("/proc/meminfo").splitlines():
            key, _, rest = line.partition(":")
            mem[key] = int(rest.split()[0]) * 1024 if rest.split() else 0
        s["mem_total"] = mem.get("MemTotal", 0)
        s["mem_used"] = mem.get("MemTotal", 0) - mem.get("MemAvailable", 0)
        s["mem_cached"] = mem.get("Cached", 0)
        s["swap_used"] = mem.get("SwapTotal", 0) - mem.get("SwapFree", 0)
        s["llama_rss"] = self._llama_rss()

        g = self.gpu_dev
        if g:
            s["gpu_busy"] = int(read(g / "gpu_busy_percent", "0") or 0)
            s["vram_used"] = int(read(g / "mem_info_vram_used", "0") or 0)
            s["vram_total"] = int(read(g / "mem_info_vram_total", "0") or 0)
            s["gtt_used"] = int(read(g / "mem_info_gtt_used", "0") or 0)
            s["sclk"] = self._dpm(g / "pp_dpm_sclk")
            s["mclk"] = self._dpm(g / "pp_dpm_mclk")
            h = self.gpu_hwmon
            if h:
                s["gpu_temp"] = int(read(h / "temp1_input", "0") or 0) / 1000
                s["gpu_hot"] = int(read(h / "temp2_input", "0") or 0) / 1000
                power = read(h / "power1_average") or read(h / "power1_input")
                s["gpu_watts"] = int(power or 0) / 1e6
                s["gpu_fan"] = int(read(h / "fan1_input", "0") or 0)
            s["gpu_name"] = read(g / "product_name") or "GPU"

        now = time.monotonic()
        if self.net_if:
            rx = int(read(f"/sys/class/net/{self.net_if}/statistics/rx_bytes", "0"))
            tx = int(read(f"/sys/class/net/{self.net_if}/statistics/tx_bytes", "0"))
            if self.prev_net:
                dt = max(now - self.prev_net[0], 1e-3)
                self.net_rx = (rx - self.prev_net[1]) / dt
                self.net_tx = (tx - self.prev_net[2]) / dt
            self.prev_net = (now, rx, tx)
        s["net_if"], s["net_rx"], s["net_tx"] = self.net_if, self.net_rx, self.net_tx
        s["uptime"] = float(read("/proc/uptime", "0").split()[0] or 0)
        return s

    @staticmethod
    def _dpm(path: Path) -> str:
        for line in read(path).splitlines():
            if line.endswith("*"):
                return line.split()[1]
        return ""

    @staticmethod
    def _llama_rss() -> int:
        total = 0
        for proc in Path("/proc").glob("[0-9]*"):
            try:
                if (proc / "comm").read_text().strip() != "llama-server":
                    continue
                for line in (proc / "status").read_text().splitlines():
                    if line.startswith("VmRSS:"):
                        total += int(line.split()[1]) * 1024
            except OSError:
                continue
        return total


def service_state() -> tuple[str, float]:
    try:
        out = subprocess.run(
            ["systemctl", "show", SERVICE, "-p", "ActiveState", "-p", "ActiveEnterTimestampMonotonic"],
            capture_output=True, text=True, timeout=2).stdout
    except (OSError, subprocess.TimeoutExpired):
        return "unknown", 0.0
    props = dict(line.split("=", 1) for line in out.splitlines() if "=" in line)
    since = int(props.get("ActiveEnterTimestampMonotonic", "0") or 0) / 1e6
    up = time.clock_gettime(time.CLOCK_MONOTONIC) - since if since else 0.0
    return props.get("ActiveState", "unknown"), up


# ------------------------------------------------------------------- state --


@dataclass
class SlotTrack:
    task: int = -1
    prompt_done: int = 0
    decoded: int = 0
    t: float = 0.0


@dataclass
class State:
    models: list[dict] = field(default_factory=list)
    active: str = ""
    props: dict = field(default_factory=dict)
    slots: list[dict] = field(default_factory=list)
    metrics: dict[str, float] = field(default_factory=dict)
    requests: list[Request] = field(default_factory=list)
    facts: dict[str, str] = field(default_factory=dict)
    log: list[str] = field(default_factory=list)
    system: dict = field(default_factory=dict)
    service: str = "unknown"
    service_up: float = 0.0
    pp_live: float = 0.0
    tg_live: float = 0.0
    pp_hist: collections.deque = field(default_factory=lambda: collections.deque(maxlen=HISTORY))
    tg_hist: collections.deque = field(default_factory=lambda: collections.deque(maxlen=HISTORY))
    tracks: dict[int, SlotTrack] = field(default_factory=dict)
    note: str = ""
    note_until: float = 0.0


class Collector:
    def __init__(self, api: Api) -> None:
        self.api = api
        self.system = System()
        self.state = State()
        self.last_journal = 0.0
        self.last_service = 0.0

    def poll(self) -> State:
        st = self.state
        now = time.monotonic()
        st.system = self.system.sample()
        if now - self.last_service > 2:
            st.service, st.service_up = service_state()
            self.last_service = now

        listing = self.api.json("/models")
        st.models = listing.get("data", []) if isinstance(listing, dict) else []
        loaded = [m.get("id") for m in st.models if model_status(m) == "loaded"]
        st.active = loaded[0] if loaded else ""
        st.pp_live = st.tg_live = 0.0
        if st.active:
            q = "?model=" + urllib.request.quote(st.active)
            st.props = self.api.json("/props" + q) or {}
            slots = self.api.json("/slots" + q)
            st.slots = slots if isinstance(slots, list) else []
            text = self.api.text("/metrics" + q)
            if text:
                st.metrics = parse_metrics(text)
            self._rates(now)
        else:
            st.props, st.slots = {}, []
            st.tracks.clear()
        st.pp_hist.append(st.pp_live)
        st.tg_hist.append(st.tg_live)

        if now - self.last_journal > 4:
            st.requests, facts, st.log = parse_journal(journal(SERVICE))
            st.facts = facts
            self.last_journal = now
        return st

    def _rates(self, now: float) -> None:
        st = self.state
        for slot in st.slots:
            sid = slot.get("id", 0)
            nxt = (slot.get("next_token") or [{}])[0]
            task = slot.get("id_task", -1)
            done = int(slot.get("n_prompt_tokens_processed", 0) or 0)
            decoded = int(nxt.get("n_decoded", 0) or 0)
            tr = st.tracks.get(sid)
            if tr and tr.task == task and slot.get("is_processing"):
                dt = max(now - tr.t, 1e-3)
                st.pp_live += max(0, done - tr.prompt_done) / dt
                st.tg_live += max(0, decoded - tr.decoded) / dt
            st.tracks[sid] = SlotTrack(task, done, decoded, now)


