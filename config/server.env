# qinda-llm.service settings.
#
# Address llama-server listens on. 127.0.0.1 keeps it local; qinda's
# Tailscale address (tailscale ip -4) serves the tailnet only.
QINDA_LLM_HOST=127.0.0.1
QINDA_LLM_PORT=8100

# Extra router arguments, e.g. "--sleep-idle-seconds 1800" to unload the
# model and free its RAM and VRAM after half an hour without requests.
QINDA_LLM_EXTRA_ARGS=
